# Public Arc Testnet configuration (safe to expose to the browser)
VITE_MORROW_MODE=mock
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_CHAIN_ID=5042002
VITE_MORROW_MARKET_ADDRESS=

# Server-only Circle configuration. Never prefix these with VITE_.
CIRCLE_API_KEY=
CIRCLE_APP_ID=
# Not used by Morrow's User-Controlled Wallet flow. Keep empty.
CIRCLE_ENTITY_SECRET=
CIRCLE_WEBHOOK_SUBSCRIPTION_ID=
CIRCLE_WEBHOOK_PUBLIC_KEY=

# Deployment-only values. Never add a real key to this file or commit it.
PROTOCOL_FEE_RECIPIENT=
DEPLOYER_PRIVATE_KEY=
